---
import { asset } from '../../utils/asset';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href={asset('/')} class="logo" aria-label="Home">
        <span class="logo-mark">KB</span>
        <span class="logo-name">Kaitlyn Beebe — Realtor</span>
      </a>
      <p class="footer-tagline">
        Helping buyers find quality homes in communities they'll love.
      </p>

      <div class="brokerage-logos">
        <p class="brokerage-label">Brokerage Partners</p>
        <div class="logos-row">
          <div class="logo-card logo-card--light">
            <img src={asset('/images/branding/moomaw-logo.jpg')} alt="House Moomaw Realty Group" class="brokerage-logo" />
          </div>
          <div class="logo-card logo-card--bare">
            <img src={asset('/images/branding/regal-logo.png')} alt="Regal Realtors" class="brokerage-logo" />
          </div>
        </div>
      </div>
    </div>

    <nav class="footer-nav" aria-label="Footer navigation">
      <span class="footer-nav-label">Communities</span>
      <a href={asset('/communities/park-central')}>Park Central</a>
      <a href={asset('/communities/grace-haven')}>Grace Haven</a>
    </nav>

    <nav class="footer-nav" aria-label="Footer quick links">
      <span class="footer-nav-label">Quick Links</span>
      <a href={asset('/')}>Home</a>
      <a href={asset('/communities')}>All Communities</a>
      <a href={asset('/#contact')}>Contact</a>
    </nav>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>&copy; {year} Kaitlyn Beebe — Realtor. All rights reserved.</p>
      <p class="footer-financing">Financing support by Kelly Bergman, Mortgage Loan Originator.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-primary);
    color: rgba(255,255,255,0.85);
    margin-top: auto;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-12);
    padding-block: var(--space-16);
  }

  /* Brand */
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    margin-bottom: var(--space-4);
  }

  .logo-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: rgba(255,255,255,0.15);
    color: #fff;
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.05em;
    border-radius: var(--radius-sm);
  }

  .logo-name {
    font-size: var(--font-size-sm);
    font-weight: 700;
    color: #fff;
  }

  .footer-tagline {
    font-size: var(--font-size-sm);
    color: rgba(255,255,255,0.6);
    line-height: 1.6;
    max-width: 28ch;
    margin-bottom: var(--space-6);
  }

  .brokerage-logos {
    margin-top: var(--space-2);
  }

  .brokerage-label {
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.4);
    margin-bottom: var(--space-3);
  }

  .logos-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .logo-card {
    border-radius: var(--radius-sm);
    padding: 6px 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-card--light {
    background: #fff;
  }

  .logo-card--bare {
    background: none;
    border: none;
    box-shadow: none;
    padding: 0;
  }

  .brokerage-logo {
    height: 36px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  /* Nav columns */
  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-nav-label {
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.5);
    margin-bottom: var(--space-1);
  }

  .footer-nav a {
    font-size: var(--font-size-sm);
    color: rgba(255,255,255,0.75);
    text-decoration: none;
    transition: color var(--transition);
  }
  .footer-nav a:hover {
    color: #fff;
  }

  /* Bottom bar */
  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.1);
    padding-block: var(--space-5);
  }

  .footer-bottom p {
    font-size: var(--font-size-xs);
    color: rgba(255,255,255,0.45);
  }

  .footer-financing {
    font-size: var(--font-size-xs);
    color: rgba(255,255,255,0.28);
    margin-top: var(--space-1);
  }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
