---
/**
 * PropertySearch — client-side search/filter for community pages.
 *
 * Receives the full list of properties for a community as a serialized JSON string.
 * Vanilla JS filters the already-rendered property cards in the DOM.
 * No external dependencies needed.
 *
 * How it works:
 *   1. PropertyCard components are rendered server-side with data-lot and data-address attributes.
 *   2. This component adds a search input above the grid.
 *   3. On input, it compares the query against each card's data attributes and shows/hides cards.
 *   4. A "no results" message is shown when nothing matches.
 */
---

<div class="search-bar-wrapper">
  <label for="property-search" class="sr-only">Search by lot number or address</label>
  <div class="search-input-wrap">
    <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
    </svg>
    <input
      type="search"
      id="property-search"
      class="form-input search-input"
      placeholder="Search by lot number or address..."
      autocomplete="off"
    />
    <button type="button" class="search-clear" id="search-clear" aria-label="Clear search" hidden>
      &times;
    </button>
  </div>
  <p class="search-hint">
    Try "Lot 4" or "Birchwood"
  </p>
</div>

<div id="search-no-results" class="search-no-results" hidden>
  <p>No homes matched your search. <button type="button" id="search-reset" class="search-reset-btn">Clear search</button></p>
</div>

<script>
  const input        = document.getElementById('property-search') as HTMLInputElement | null;
  const clearBtn     = document.getElementById('search-clear') as HTMLButtonElement | null;
  const resetBtn     = document.getElementById('search-reset') as HTMLButtonElement | null;
  const noResults    = document.getElementById('search-no-results') as HTMLElement | null;

  // All property cards in the grid below this component
  function getCards(): NodeListOf<HTMLAnchorElement> {
    return document.querySelectorAll<HTMLAnchorElement>('[data-lot][data-address]');
  }

  function filterCards(query: string) {
    const q = query.trim().toLowerCase();
    const cards = getCards();
    let visibleCount = 0;

    cards.forEach((card) => {
      const lot     = card.dataset.lot     ?? '';
      const address = card.dataset.address ?? '';
      const matches = !q || lot.includes(q) || address.includes(q);

      card.style.display = matches ? '' : 'none';
      if (matches) visibleCount++;
    });

    if (noResults) noResults.hidden = visibleCount > 0 || !q;
    if (clearBtn)  clearBtn.hidden  = !q;
  }

  input?.addEventListener('input', () => filterCards(input.value));

  clearBtn?.addEventListener('click', () => {
    if (input) {
      input.value = '';
      input.focus();
      filterCards('');
    }
  });

  resetBtn?.addEventListener('click', () => {
    if (input) {
      input.value = '';
      filterCards('');
      input.focus();
    }
  });
</script>

<style>
  .search-bar-wrapper {
    margin-bottom: var(--space-8);
  }

  .search-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
    max-width: 480px;
  }

  .search-icon {
    position: absolute;
    left: var(--space-4);
    color: var(--color-text-muted);
    pointer-events: none;
    flex-shrink: 0;
  }

  .search-input {
    padding-left: calc(var(--space-4) + 18px + var(--space-3));
    padding-right: var(--space-10);
    width: 100%;
    font-size: var(--font-size-base);
  }

  .search-clear {
    position: absolute;
    right: var(--space-3);
    background: none;
    border: none;
    font-size: 1.25rem;
    line-height: 1;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: var(--space-1);
    transition: color var(--transition);
  }
  .search-clear:hover {
    color: var(--color-text);
  }

  .search-hint {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin-top: var(--space-2);
    margin-left: var(--space-1);
  }

  .search-no-results {
    text-align: center;
    padding: var(--space-12) 0;
    color: var(--color-text-muted);
  }

  .search-reset-btn {
    background: none;
    border: none;
    color: var(--color-primary);
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
    font-size: inherit;
  }
</style>
