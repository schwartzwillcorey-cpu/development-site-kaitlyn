---
interface Props {
  heading?: string;
  body?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  variant?: 'dark' | 'light';
}

const {
  heading = 'Ready to find your next home?',
  body = 'Browse available homes in our communities or get in touch and we\'ll help you find the right fit.',
  primaryLabel = 'View Communities',
  primaryHref = '/communities',
  secondaryLabel = 'Contact Us',
  secondaryHref = '/#contact',
  variant = 'dark',
} = Astro.props;
---

<section class={`cta-section cta-section--${variant}`}>
  <div class="container cta-inner">
    <div class="cta-content">
      <h2 class="cta-heading">{heading}</h2>
      <p class="cta-body">{body}</p>
    </div>
    <div class="cta-actions">
      <a href={primaryHref} class="btn btn-primary">{primaryLabel}</a>
      {secondaryLabel && (
        <a href={secondaryHref} class="btn btn-outline-white">{secondaryLabel}</a>
      )}
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding-block: var(--space-20);
  }

  .cta-section--dark {
    background: var(--color-primary);
    color: #fff;
  }

  .cta-section--light {
    background: var(--color-surface-alt);
    color: var(--color-text);
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-10);
  }

  .cta-content {
    max-width: 56ch;
  }

  .cta-heading {
    font-size: var(--font-size-3xl);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: var(--space-4);
  }

  .cta-section--dark .cta-heading {
    color: #fff;
  }

  .cta-body {
    font-size: var(--font-size-lg);
    line-height: 1.6;
  }

  .cta-section--dark .cta-body {
    color: rgba(255,255,255,0.75);
  }

  .cta-actions {
    display: flex;
    gap: var(--space-4);
    flex-shrink: 0;
  }

  .btn-outline-white {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3) var(--space-6);
    font-size: var(--font-size-sm);
    font-weight: 600;
    border-radius: var(--radius-md);
    border: 1.5px solid rgba(255,255,255,0.5);
    color: #fff;
    background: transparent;
    transition: border-color var(--transition), background var(--transition);
    text-decoration: none;
  }
  .btn-outline-white:hover {
    border-color: #fff;
    background: rgba(255,255,255,0.1);
  }

  @media (max-width: 768px) {
    .cta-inner {
      flex-direction: column;
      text-align: center;
      align-items: center;
    }
    .cta-content {
      max-width: 100%;
    }
    .cta-heading {
      font-size: var(--font-size-2xl);
    }
    .cta-actions {
      flex-direction: column;
      width: 100%;
    }
    .cta-actions .btn,
    .cta-actions .btn-outline-white {
      width: 100%;
      justify-content: center;
    }
  }
</style>
