---
import type { Property } from '../../data/types';
import StatusBadge from './StatusBadge.astro';

interface Props {
  property: Property;
}

const { property } = Astro.props;

const {
  slug, address, lotNumber, status, price, beds, baths, sqft, images, communitySlug
} = property;

const thumbnail = images[0] ?? null;
const formattedPrice = price.toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
const isSold = status === 'sold';
---

<a
  href={`/homes/${slug}`}
  class:list={['property-card', { 'property-card--sold': isSold }]}
  data-lot={lotNumber.toLowerCase()}
  data-address={address.toLowerCase()}
>
  <div class="card-image">
    {thumbnail ? (
      <img src={thumbnail} alt={`${address} — ${lotNumber}`} loading="lazy" />
    ) : (
      <div class="img-placeholder" style="height:100%;">No image</div>
    )}
    <div class="card-badge">
      <StatusBadge status={status} />
    </div>
  </div>

  <div class="card-body">
    <p class="card-lot">{lotNumber}</p>
    <h3 class="card-address">{address}</h3>

    <p class="card-price">
      {isSold ? 'Sold' : formattedPrice}
    </p>

    <ul class="card-meta" aria-label="Property details">
      <li>{beds} <span>bd</span></li>
      <li>{baths} <span>ba</span></li>
      <li>{sqft.toLocaleString()} <span>sqft</span></li>
    </ul>
  </div>
</a>

<style>
  .property-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    transition: box-shadow var(--transition), transform var(--transition);
  }

  .property-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .property-card--sold {
    opacity: 0.65;
    filter: grayscale(0.3);
  }
  .property-card--sold:hover {
    transform: none;
    box-shadow: var(--shadow-sm);
  }

  /* Image */
  .card-image {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--color-surface-alt);
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  .property-card:hover .card-image img {
    transform: scale(1.03);
  }

  .card-badge {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
  }

  /* Body */
  .card-body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .card-lot {
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .card-address {
    font-size: var(--font-size-base);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.3;
    margin: 0;
  }

  .card-price {
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--color-primary);
    margin-top: var(--space-1);
  }

  .card-meta {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin-top: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border-light);
  }

  .card-meta li {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text);
  }

  .card-meta li span {
    font-weight: 400;
    color: var(--color-text-muted);
    margin-left: 2px;
  }
</style>
