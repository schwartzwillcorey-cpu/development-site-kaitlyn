---
import BaseLayout from '../components/layout/BaseLayout.astro';
import CommunityCard from '../components/ui/CommunityCard.astro';
import PropertyCard from '../components/ui/PropertyCard.astro';
import CTASection from '../components/ui/CTASection.astro';
import InquiryForm from '../components/ui/InquiryForm.astro';

import { asset } from '../utils/asset';
import { communities } from '../data/communities';
import { getFeaturedProperties } from '../data/properties';

const featuredHomes = getFeaturedProperties();
---

<BaseLayout
  title="Kaitlyn Beebe — Realtor"
  description="Browse quality new construction homes in Park Central and Grace Haven. Clean, move-in ready homes listed by Kaitlyn Beebe, Realtor."
>

  <!-- ── Hero ────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      {/* Drop your hero image at public/images/hero.jpg and it will appear here */}
      <img src={asset('/images/hero.jpg')} alt="" class="hero-img" />
      <div class="hero-overlay"></div>
    </div>
    <div class="container hero-inner">
      <div class="hero-content">
        <p class="section-label">New Construction Homes</p>
        <h1 class="hero-heading">
          Find your home in a community you'll love.
        </h1>
        <p class="hero-partnership">
          Kaitlyn Beebe, Realtor &nbsp;·&nbsp; in partnership with Kelly Bergman, Mortgage Loan Originator
        </p>
        <p class="hero-sub">
          Quality new construction homes across two communities. Clean finishes, thoughtful layouts, and neighborhoods worth settling into.
        </p>
        <div class="hero-actions">
          <a href={asset('/communities')} class="btn btn-primary">Browse Communities</a>
          <a href="#featured" class="btn btn-ghost">See Featured Homes</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Overview ──────────────────────────────────────────────── -->
  <section class="section overview-section">
    <div class="container">
      <div class="overview-grid">
        <div class="overview-text">
          <p class="section-label">Our Communities</p>
          <h2 class="section-title">Built for real life, not showrooms.</h2>
          <p class="overview-body">
            We focus on a small number of communities and take our time doing them right.
            Every home is built with durable materials, sensible layouts, and the kind of
            attention to detail that shows up years after move-in — not just on opening day.
          </p>
          <p class="overview-body" style="margin-top: 1rem;">
            Currently available homes span two communities.
            Browse both, or scan the QR code on any sign to go directly to that community's listings.
          </p>
        </div>
        <div class="overview-stats">
          <div class="stat">
            <span class="stat-number">2</span>
            <span class="stat-label">Communities</span>
          </div>
          <div class="stat">
            <span class="stat-number">13+</span>
            <span class="stat-label">Homes Available</span>
          </div>
          <div class="stat">
            <span class="stat-number">3–4</span>
            <span class="stat-label">Bedrooms</span>
          </div>
          <div class="stat">
            <span class="stat-number">$220k+</span>
            <span class="stat-label">Starting From</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Buying Here? ─────────────────────────────────────────── -->
  <section class="section-sm why-section">
    <div class="container">
      <div class="why-layout">
        <div class="why-text">
          <p class="section-label">Built for You</p>
          <h2 class="why-heading">Buying in these communities?</h2>
          <p class="why-body">
            This site was built to make the process simple. Browse available homes at your own pace, see real pricing upfront, and understand your options — without needing to call anyone first. When you're ready to move forward, one message is all it takes.
          </p>
        </div>
        <div class="why-points">
          <div class="why-point">
            <span class="why-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </span>
            <div>
              <p class="why-point-title">Real listings, real pricing</p>
              <p class="why-point-body">Every home is live, up to date, and priced upfront.</p>
            </div>
          </div>
          <div class="why-point">
            <span class="why-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </span>
            <div>
              <p class="why-point-title">Run the numbers first</p>
              <p class="why-point-body">Every listing includes a built-in payment estimator.</p>
            </div>
          </div>
          <div class="why-point">
            <span class="why-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </span>
            <div>
              <p class="why-point-title">Connect when you're ready</p>
              <p class="why-point-body">No pressure. Schedule a showing on your own timeline.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Communities ───────────────────────────────────────────── -->
  <section class="section communities-section" style="background: var(--color-surface-alt);">
    <div class="container">
      <p class="section-label">Where We Build</p>
      <h2 class="section-title">Two communities, both worth your time.</h2>
      <p class="section-subtitle" style="margin-bottom: var(--space-10);">
        Each community has its own character. Browse homes in either, or visit the community page by scanning the sign.
      </p>
      <div class="grid-2">
        {communities.map((c) => <CommunityCard community={c} />)}
      </div>
    </div>
  </section>

  <!-- ── How It Works ─────────────────────────────────────────────── -->
  <section class="section how-section">
    <div class="container">
      <div class="how-header">
        <p class="section-label">Simple Process</p>
        <h2 class="section-title">How it works</h2>
        <p class="section-subtitle">Three steps from browsing to getting the keys.</p>
      </div>
      <div class="how-steps">

        <div class="how-step">
          <div class="step-num">1</div>
          <div class="step-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
          <h3 class="step-title">Browse homes</h3>
          <p class="step-body">Explore available listings across both communities. Filter by lot or address — no account needed.</p>
        </div>

        <div class="how-step-arrow" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </div>

        <div class="how-step">
          <div class="step-num">2</div>
          <div class="step-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h3 class="step-title">Check your options</h3>
          <p class="step-body">Use the payment estimator on any listing. VA and zero-down programs available for qualified buyers.</p>
        </div>

        <div class="how-step-arrow" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </div>

        <div class="how-step">
          <div class="step-num">3</div>
          <div class="step-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <h3 class="step-title">Schedule a showing</h3>
          <p class="step-body">Ready to see it in person? Reach out to Kaitlyn directly. She'll handle the rest.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ── Featured Homes ─────────────────────────────────────────── -->
  <section class="section" id="featured">
    <div class="container">
      <p class="section-label">Featured Homes</p>
      <h2 class="section-title">Homes worth a closer look.</h2>
      <p class="section-subtitle" style="margin-bottom: var(--space-10);">
        A selection of our current standout listings. Click any home for full details.
      </p>
      {featuredHomes.length > 0 ? (
        <div class="grid-3">
          {featuredHomes.map((p) => <PropertyCard property={p} />)}
        </div>
      ) : (
        <p style="color: var(--color-text-muted);">Check back soon for featured listings.</p>
      )}
      <div style="margin-top: var(--space-10); text-align: center;">
        <a href={asset('/communities')} class="btn btn-outline">View All Communities</a>
      </div>
    </div>
  </section>

  <!-- ── CTA Banner ─────────────────────────────────────────────── -->
  <CTASection
    heading="Interested in a specific home or community?"
    body="We'd love to answer your questions, schedule a showing, or walk you through what's available right now."
    primaryLabel="Browse Communities"
    primaryHref="/communities"
    secondaryLabel="Get in Touch"
    secondaryHref="#contact"
  />

  <!-- ── Meet Kaitlyn ─────────────────────────────────────────────── -->
  <section class="section meet-section">
    <div class="container">
      <div class="meet-layout">
        <div class="meet-image-wrap">
          <img
            src={asset('/images/kailyn headshot.jpg')}
            alt="Kaitlyn Beebe — Realtor"
            class="meet-image"
            loading="lazy"
          />
        </div>
        <div class="meet-content">
          <p class="section-label">Your Realtor</p>
          <h2 class="section-title">Meet Kaitlyn</h2>
          <p class="meet-bio">
            Kaitlyn Beebe is a local Realtor focused on helping buyers find quality homes in East Texas communities they'll actually love. She keeps the process clear and low-pressure — no guesswork, no runaround — so you can make confident decisions at your own pace.
          </p>
          <p class="meet-bio">
            Whether you're a first-time buyer still figuring things out, or you know exactly what you want and just need to move, Kaitlyn is with you from first showing through closing day.
          </p>
          <div class="meet-contact-info">
            <a href="mailto:kaitlyn@housemoomaw.com" class="meet-detail">kaitlyn@housemoomaw.com</a>
            <a href="tel:+19039109283" class="meet-detail">(903) 910-9283</a>
          </div>
          <a href="#contact" class="btn btn-primary meet-cta">Contact Kaitlyn</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Your Home Buying Team ──────────────────────────────────── -->
  <section class="section team-section">
    <div class="container">
      <p class="section-label">Your Team</p>
      <h2 class="section-title">Your home buying team.</h2>
      <p class="section-subtitle" style="margin-bottom: var(--space-12);">
        Two specialists working together — one to find your home, one to fund it.
      </p>
      <div class="team-grid">
        <div class="team-card team-card--primary">
          <img src={asset('/images/kailyn headshot.jpg')} alt="Kaitlyn Beebe" class="team-headshot" />
          <p class="team-role">Realtor</p>
          <h3 class="team-name">Kaitlyn Beebe</h3>
          <p class="team-desc">
            Kaitlyn handles every step of finding and securing your home — community tours,
            offer strategy, negotiations, and making sure closing day goes smoothly.
          </p>
          <ul class="team-contact-list">
            <li><a href="mailto:kaitlyn@housemoomaw.com">kaitlyn@housemoomaw.com</a></li>
            <li><a href="tel:+19039109283">(903) 910-9283</a></li>
          </ul>
          <a href="#contact" class="btn btn-primary team-btn">Schedule a Showing</a>
        </div>
        <div class="team-card">
          <img src={asset('/images/kelly-headshot.jpg')} alt="Kelly Bergman" class="team-headshot" />
          <p class="team-role">Mortgage Loan Originator</p>
          <h3 class="team-name">Kelly Bergman</h3>
          <p class="team-desc">
            Kelly guides buyers through the financing side — pre-approval, loan programs,
            and zero down options — so you know exactly what you can afford before you fall in love with a home.
          </p>
          <ul class="team-contact-list">
            <li><a href="tel:+19034747570">(903) 474-7570</a></li>
            <li><a href="mailto:team@loanswithkb.com">team@loanswithkb.com</a></li>
            <li class="team-nmls">NMLS #1786042</li>
          </ul>
          <a href="tel:+19034747570" class="btn btn-outline team-btn">Talk to Kelly</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Contact / Inquiry ──────────────────────────────────────── -->
  <section class="section" id="contact">
    <div class="container">
      <div class="contact-header">
        <p class="section-label">Get in Touch</p>
        <h2 class="section-title">Reach the right person.</h2>
        <p class="section-subtitle">
          Questions about a home? That's Kaitlyn. Questions about how to pay for it? That's Kelly.
        </p>
      </div>
      <div class="contact-split">

        <div class="contact-col">
          <div class="contact-col-header">
            <img src={asset('/images/kailyn headshot.jpg')} alt="Kaitlyn Beebe" class="contact-headshot" />
            <p class="contact-col-role">Tours &amp; Showings</p>
            <h3 class="contact-col-name">Kaitlyn Beebe</h3>
            <p class="contact-col-title">Realtor</p>
          </div>
          <ul class="contact-details">
            <li>
              <span class="contact-detail-label">Email</span>
              <a href="mailto:kaitlyn@housemoomaw.com">kaitlyn@housemoomaw.com</a>
            </li>
            <li>
              <span class="contact-detail-label">Phone</span>
              <a href="tel:+19039109283">(903) 910-9283</a>
            </li>
          </ul>
          <InquiryForm
            contextType="general"
            heading="Send Kaitlyn a message"
          />
        </div>

        <div class="contact-col contact-col--kelly">
          <div class="contact-col-header">
            <img src={asset('/images/kelly-headshot.jpg')} alt="Kelly Bergman" class="contact-headshot" />
            <p class="contact-col-role">Financing &amp; Pre-Approval</p>
            <h3 class="contact-col-name">Kelly Bergman</h3>
            <p class="contact-col-title">Mortgage Loan Originator</p>
          </div>
          <ul class="contact-details" style="margin-top: 0; margin-bottom: var(--space-6);">
            <li>
              <span class="contact-detail-label">Phone</span>
              <a href="tel:+19034747570">(903) 474-7570</a>
            </li>
            <li>
              <span class="contact-detail-label">Email</span>
              <a href="mailto:team@loanswithkb.com">team@loanswithkb.com</a>
            </li>
            <li>
              <span class="contact-detail-label">NMLS</span>
              <span style="font-size: var(--font-size-sm); font-weight: 600; color: var(--color-text-muted);">#1786042</span>
            </li>
          </ul>
          <div class="kelly-contact-card">
            <p class="kelly-card-heading">Ready to explore your options?</p>
            <p class="kelly-card-body">
              Kelly can walk you through pre-approval, loan programs, and zero down
              options — before you ever make an offer.
            </p>
            <a href="tel:+19034747570" class="btn btn-outline kelly-call-btn">Call Kelly</a>
          </div>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: 560px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    /* Fallback color shown while image loads or if no image is present */
    background: linear-gradient(135deg, var(--color-primary) 0%, #1a3328 100%);
    z-index: 0;
  }

  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    /* Hidden automatically if the image 404s — fallback gradient shows through */
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(10, 30, 20, 0.72) 0%,
      rgba(10, 30, 20, 0.45) 100%
    );
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    padding-block: var(--space-24);
  }

  .hero-content {
    max-width: 600px;
  }

  .hero-content .section-label {
    color: rgba(255,255,255,0.6);
  }

  .hero-heading {
    font-size: clamp(2rem, 5vw, var(--font-size-5xl));
    font-weight: 700;
    color: #fff;
    line-height: 1.15;
    margin-bottom: var(--space-5);
    letter-spacing: -0.02em;
  }

  .hero-sub {
    font-size: var(--font-size-lg);
    color: rgba(255,255,255,0.75);
    line-height: 1.65;
    margin-bottom: var(--space-8);
    max-width: 50ch;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .hero-actions .btn-ghost {
    color: rgba(255,255,255,0.85);
    border: 1.5px solid rgba(255,255,255,0.25);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-6);
    font-size: var(--font-size-sm);
    font-weight: 600;
    transition: background var(--transition), border-color var(--transition);
  }
  .hero-actions .btn-ghost:hover {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.5);
  }

  /* Overview */
  .overview-section {
    background: var(--color-bg);
  }

  .overview-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-16);
    align-items: center;
  }

  .overview-body {
    color: var(--color-text-muted);
    font-size: var(--font-size-base);
    line-height: 1.7;
  }

  .overview-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .stat {
    background: var(--color-surface);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .stat-number {
    font-size: var(--font-size-3xl);
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1;
  }

  .stat-label {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* Hero partnership line */
  .hero-partnership {
    font-size: var(--font-size-xs);
    color: rgba(255,255,255,0.5);
    font-weight: 500;
    letter-spacing: 0.02em;
    margin-bottom: var(--space-5);
    margin-top: calc(-1 * var(--space-3));
  }

  /* Team section */
  .team-section {
    background: var(--color-surface-alt);
  }

  .team-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: var(--space-6);
    align-items: start;
  }

  .team-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
  }

  .team-card--primary {
    border-color: var(--color-primary);
    border-width: 2px;
  }

  .team-headshot {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center top;
    margin-bottom: var(--space-5);
    border: 3px solid var(--color-border-light);
  }

  .team-card--primary .team-headshot {
    border-color: var(--color-primary);
  }

  .team-role {
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }

  .team-name {
    font-size: var(--font-size-2xl);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }

  .team-desc {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: 1.7;
    margin-bottom: var(--space-5);
    flex: 1;
  }

  .team-contact-list {
    list-style: none;
    margin-bottom: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .team-contact-list a {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
  }
  .team-contact-list a:hover {
    text-decoration: underline;
  }

  .team-nmls {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .team-btn {
    width: 100%;
    justify-content: center;
  }

  /* Contact */
  .contact-header {
    max-width: 56ch;
    margin-bottom: var(--space-10);
  }

  .contact-split {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .contact-col-header {
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-border-light);
  }

  .contact-headshot {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center top;
    border: 2px solid var(--color-border-light);
    margin-bottom: var(--space-4);
    display: block;
  }

  .contact-col-role {
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-bottom: var(--space-1);
  }

  .contact-col-name {
