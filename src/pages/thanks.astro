---
import BaseLayout from '../components/layout/BaseLayout.astro';
import { asset } from '../utils/asset';
---

<BaseLayout
  title="Message Received"
  description="Thank you for your inquiry. We'll be in touch shortly."
>
  <section class="section thanks-section">
    <div class="container">
      <div class="thanks-card">
        <div class="thanks-icon" aria-hidden="true">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
        </div>
        <h1 class="thanks-title">Message received.</h1>
        <p class="thanks-body">
          Thank you for reaching out. We'll follow up within one business day.
        </p>
        <div class="thanks-actions">
          <a href={asset('/communities')} class="btn btn-primary">Browse Communities</a>
          <a href={asset('/')} class="btn btn-ghost">Back to Home</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .thanks-section {
    min-height: 60vh;
    display: flex;
    align-items: center;
  }

  .thanks-card {
    max-width: 480px;
    margin: 0 auto;
    text-align: center;
    padding: var(--space-16) var(--space-8);
    background: var(--color-surface);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
  }

  .thanks-icon {
    color: var(--color-primary);
    margin-bottom: var(--space-6);
  }

  .thanks-title {
    font-size: var(--font-size-3xl);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }

  .thanks-body {
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
    line-height: 1.6;
    margin-bottom: var(--space-8);
  }

  .thanks-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
</style>
